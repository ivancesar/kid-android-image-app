<resources>
    <!--
      The launcher icon's two tones, sampled from icons-src/launcher.png. The
      amber is the base; the light tone is the upper-left triangle. Both are
      referenced by drawable/ic_launcher_background.xml.
    -->
    <color name="ic_launcher_background">#FACB45</color>
    <color name="ic_launcher_background_light">#FEFFCE</color>

    <!--
      The sRGB value of NeutralColors.appBackground, i.e. oklch(0.96 0.01 90).
      Used only as the cold-start windowBackground, so the launch window matches
      the Surface that Compose paints a moment later instead of flashing white.
      Keep the two in step if that OKLCH value ever changes.
    -->
    <color name="app_background">#F4F2EA</color>
</resources>
