    <!--
      Theme names and the item labels behind them. These are the app's primary
      content — the words a child actually sees — so they live here with
      everything else translatable rather than as literals in ThemeDef.kt.

      Each array's length must match its theme's `labelCount` in ThemeDef.kt;
      ThemeResourcesTest asserts that for every theme, because the ViewModel
      wraps its index against labelCount without being able to see resources.
    -->
    <string name="theme_cars">Cars</string>
    <string-array name="labels_cars">
        <item>Red sports car, side view</item>
        <item>Yellow taxi, front view</item>
        <item>Blue pickup truck</item>
        <item>Green race car with number</item>
        <item>Police car with lights on</item>
        <item>Yellow school bus</item>
        <item>Motorcycle, side view</item>
        <item>Orange convertible car</item>
    </string-array>

    <string name="theme_construction">Construction</string>
    <!--
      Construction has photographs, so unlike every other theme's these labels
      never reach a screen: the Viewer shows the picture and nothing else, and
      does not describe it. They stay as the roster of what the theme holds -
      one entry per image, in the order ThemeDef.CONSTRUCTION_IMAGES lists them,
      which is what ThemeResourcesTest counts labelCount against. Treat them as
      a note to the next maintainer about which photograph is which.
    -->
