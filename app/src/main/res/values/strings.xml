    <!--
      Attribution. One line per source, each naming the category it covers —
      a single blanket line stopped being true the moment a second theme got
      its pictures somewhere else.

      The Unsplash License does not require credit and NASA's material is not
      copyrighted at all, but the photographers get named anyway; the notices
      themselves are what the app owes its sources. The names are a proper noun
      list, so they are not translatable; they are substituted into a line that
      is, so the separator and the word order stay with the language rather
      than being glued on in Kotlin.
    -->
    <string name="settings_attribution">Attribution</string>
    <string name="attribution_images">Construction images provided by Unsplash under their Unsplash Licence</string>
    <string name="attribution_photographers_line">Unsplash photographs by: %1$s</string>
    <string name="attribution_nasa">Space images are courtesy of NASA</string>
    <string name="attribution_photographers" translatable="false">Abdul Zreika, Anatol Rurac, Bernd Dittrich, Chandler Cruttenden, David Griffiths, Jamar Penny, Jason Jarrach, Maria Lupan, Michael Kora, Michal Vrba, Nihar Reddy Jangam, Wioletta Płonkowska</string>
