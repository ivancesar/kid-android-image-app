<?xml version="1.0" encoding="utf-8"?>
<!--
  Languages the app ships. Android 13+ reads this to build the per-app language
  screen in system settings; AppLocales.SUPPORTED mirrors it for the in-app
  picker, and LocalesConfigTest asserts the two never drift apart.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="hr" />
</locale-config>
