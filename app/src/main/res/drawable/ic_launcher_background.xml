<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher icon's ground: the same two-tone diagonal the theme cards use,
  running corner to corner with the lighter tone in the upper left. Drawn full
  bleed across the whole 108dp adaptive-icon viewport, not just the 72dp mask,
  so the diagonal still reaches the corners after a launcher crops it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="@color/ic_launcher_background"
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z" />
    <path
        android:fillColor="@color/ic_launcher_background_light"
        android:pathData="M0,0 L108,0 L0,108 Z" />
</vector>
