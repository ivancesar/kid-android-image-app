<?xml version="1.0" encoding="utf-8"?>
<!--
  Croatian. Keys absent here fall back to values/strings.xml on purpose:
  app_name and home_brand are the product name, gate_question is nothing but
  placeholders, attribution_photographers is a list of names, and the image
  labels of every theme except Construction are stand-in text for artwork the
  app does not ship yet.

  labels_construction is the exception: those items describe real photographs
  now, so they are what a Croatian child is actually read out.

  home_settings_button, home_empty_title, home_empty_body, the attribution
  strings and labels_construction arrived on main after the translation pass
  and were translated here rather than by the translator - worth a native
  check.
-->
<resources>

    <!-- Home screen -->
    <string name="home_title">Izaberi nešto za gledati!</string>
    <string name="home_settings_button">Postavke za roditelje</string>
    <string name="home_empty_title">Još nema ničega</string>
    <string name="home_empty_body">Sve kategorije su isključene. Otvorite postavke za roditelje da ih ponovno uključite.</string>

    <!-- Viewer screen -->
    <string name="viewer_home">Izbornik</string>
    <string name="viewer_back">Prijašnji</string>
    <string name="viewer_next">Sljedeći</string>

    <!-- Parental gate -->
    <string name="gate_eyebrow">SAMO ZA ODRASLE</string>
    <string name="gate_prompt">Riješi ovo za nastaviti</string>
    <string name="gate_wrong">Krivo, probaj opet!</string>
    <string name="gate_cancel">Odustani</string>
    <!--
      Croatian takes three plural categories where English takes two: 1 sekundu,
      2-4 sekunde, 5+ sekundi. Written here rather than by the translator - the
      string arrived on main after the translation pass - so it wants a native
      check more than anything else in this file.
    -->
    <plurals name="gate_locked">
        <item quantity="one">Previše pokušaja. Pričekajte %d sekundu.</item>
        <item quantity="few">Previše pokušaja. Pričekajte %d sekunde.</item>
        <item quantity="other">Previše pokušaja. Pričekajte %d sekundi.</item>
    </plurals>

    <!-- Parent settings -->
    <string name="settings_title">Postavke za roditelje</string>
    <string name="settings_categories">Kategorije</string>
    <string name="settings_subtitle">Odredite koje kategorije vaše dijete može vidjeti.</string>
    <string name="settings_done">Gotovo</string>

    <!-- Language picker -->
    <string name="settings_language">Jezik</string>
    <string name="settings_language_system">Prema postavkama telefona</string>

    <!-- Category names -->
    <string name="theme_cars">Auti</string>
    <string name="theme_construction">Gradnja</string>
    <string name="theme_trains">Vlakovi</string>
    <string name="theme_animals">Životinje</string>
    <string name="theme_bird">Ptice</string>
    <string name="theme_insects">Insekti</string>
    <string name="theme_ocean">Ocean</string>
    <string name="theme_farm">Farma</string>
    <string name="theme_dinosaurs">Dinosauri</string>
    <string name="theme_flowers">Cvijeće</string>
    <string name="theme_forest">Šuma</string>
    <string name="theme_fruit">Voće</string>
    <string name="theme_vegetable">Povrće</string>
    <string name="theme_space">Svemir</string>

    <!-- Attribution -->
    <string name="settings_attribution">Zasluge</string>
    <string name="attribution_images">Slike ustupio Unsplash pod svojom Unsplash licencom</string>
    <string name="attribution_photographers_line">Fotografije: %1$s</string>

    <!--
      Construction's fourteen items, in the same order as the photographs in
      ThemeDef.CONSTRUCTION_IMAGES. Every other theme's labels are left to fall
      back to English while they are still placeholder text for artwork that
      does not exist.
    -->
    <string-array name="labels_construction">
        <item>Žuti bager s velikom lopatom</item>
        <item>Žuti bager parkiran pod oblačnim plavim nebom</item>
        <item>Bager istresa zemlju u kamion kiper</item>
        <item>Veliki kamion kiper čeka pokraj bagera</item>
        <item>Žuti valjak ravna šljunak</item>
        <item>Narančasti valjak i žuti grejder</item>
        <item>Crveni utovarivač na gusjenicama sa širokom lopatom</item>
        <item>Visoka žuta toranjska dizalica iznad krovova</item>
        <item>Bager i buldožer grade novu cestu</item>
        <item>Crveni bager kopa zemlju pokraj velike zgrade</item>
        <item>Žuti bager radi uz željezničku prugu</item>
        <item>Bageri poredani u blatu</item>
        <item>Valjak i asfalter rade noću</item>
        <item>Narančasti bager na vrhu brežuljka u zalazak sunca</item>
    </string-array>
</resources>
