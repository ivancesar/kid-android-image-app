<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.KidsExplore"
        android:supportsRtl="true">

        <!--
            Rotation is deliberately left free: a phone handed to a child gets
            held every which way, and both Viewer orientations are designed for.
            No android:configChanges, so the activity is recreated on rotation —
            which is why all state lives in AppViewModel rather than the activity.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.KidsExplore">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
